{
  "name": "hermes-reflection-mcp",
  "version": "19.2.0",
  "description": "Hermes-inspired local reflection, heuristic, memory, and session MCP server",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hermes-reflection-mcp": "./dist/index.js"
  },
  "files": [
    "dist/",
    "src/",
    "scripts/smoke.mjs",
    "scripts/concurrency-test.mjs",
    "scripts/cross-process-concurrency-test.mjs",
    "index.ts",
    "storage.ts",
    "session_storage.ts",
    "types.ts",
    "tsconfig.json",
    "README.md",
    "README.en.md",
    "readmecn.md",
    "readmeen.md",
    "CHANGELOG.md",
    "INSTALL_HERMES_MCP.md",
    "codex_config_snippet.toml"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "test": "npm run smoke",
    "test:concurrency": "node scripts/concurrency-test.mjs && node scripts/cross-process-concurrency-test.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^12.11.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
